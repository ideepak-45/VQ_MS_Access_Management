{
    "name": "backendtsprod",
    "version": "1.0.0",
    "description": "Production grade typescript backend microservice",
    "license": "ISC",
    "author": "Deepak Rajveer Singh",
    "type": "commonjs",
    "main": "dist/server.js",
    "scripts": {
        "dist": "npx tsc",
        "dev": "cross-env NODE_ENV=development nodemon src/server.ts",
        "start": "cross-env NODE_ENV=production node dist/server.js",
        "lint": "eslint . --ext .js,.ts",
        "lint:fix": "eslint . --ext .js,.ts --fix",
        "format:check": "prettier --check .",
        "format:fix": "prettier --write .",
        "prepare": "husky",
        "migrate:dev": "cross-env MIGRATE_MODE=development ts-node script/mongooseModelMigration.ts",
        "migrate:prod": "cross-env MIGRATE_MODE=production ts-node script/mongooseModelMigration.ts"
    },
    "lint-staged": {
        "*.{js,ts}": [
            "npm run lint:fix",
            "npm run format:fix"
        ]
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.1.1",
        "@types/source-map-support": "^0.5.10",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "nodemon": "^3.1.14",
        "prettier": "3.9.4",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0"
    },
    "dependencies": {
        "colorette": "^2.0.20",
        "cors": "^2.8.6",
        "cross-env": "^10.1.0",
        "dotenv-flow": "^4.1.0",
        "express": "^5.2.1",
        "helmet": "^8.2.0",
        "mongoose": "^9.7.4",
        "rate-limiter-flexible": "^11.2.0",
        "source-map-support": "^0.5.21",
        "ts-migrate-mongoose": "^5.3.3",
        "winston": "^3.19.0",
        "winston-mongodb": "^7.0.1"
    }
}
